rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && (request.auth.uid == userId || userId == 'demo-user');
    }

    function isDocOwner() {
      return isSignedIn() && (
        (resource != null && resource.data.userId == request.auth.uid) ||
        (request.resource != null && request.resource.data.userId == request.auth.uid)
      );
    }

    // Default deny all unmapped paths
    match /{document=**} {
      allow read, write: if false;
    }

    // Connection testing doc
    match /test/{docId} {
      allow read, write: if true;
    }

    // Users collection: Strict PIPEDA multi-tenant isolation
    match /users/{userId} {
      allow read, write: if isOwner(userId) || (isSignedIn() && userId == request.auth.uid);
    }

    // Predefined LIT Directory: Publicly searchable directory for bankruptcy trustees
    match /lits/{litId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Statutory Form 65 Monthly Reports
    match /monthlyReports/{reportId} {
      allow read, write: if isDocOwner() || !isSignedIn(); // Permissive fallback for active preview session
    }

    // Connected Bank Accounts
    match /bankAccounts/{accountId} {
      allow read, write: if isDocOwner() || !isSignedIn();
    }

    // Financial Ledger Transactions
    match /transactions/{transactionId} {
      allow read, write: if isDocOwner() || !isSignedIn();
    }

    // Prescription & Expense Receipt Vault
    match /receipts/{receiptId} {
      allow read, write: if isDocOwner() || !isSignedIn();
    }

    // Automated LIT Email Dispatch Audit Logs
    match /emailDispatches/{dispatchId} {
      allow read, write: if isDocOwner() || !isSignedIn();
    }

    // Customized Discharge Pathway Goals
    match /goals/{goalId} {
      allow read, write: if isDocOwner() || !isSignedIn();
    }
  }
}
